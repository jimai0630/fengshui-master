{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/$1"
        }
    ],
    "functions": {
        "api/index.js": {
            "maxDuration": 60
        }
    }
}
